# This file is an example; put real values in .env, which git ignores.

# Shared secret. The app sends it as the X-Shop-Token header. Required.
# If empty, the server makes a random one at every start and prints it.
SHOP_TOKEN=

# Shown in the customer message and the voice note.
SHOP_NAME=बिजली मरम्मत दुकान
# SHOP_PHONE=9876543210

# UPI payment. Without UPI_ID there is no QR photo and no UPI line in the message.
# UPI_ID=name@okaxis
# UPI_NAME=Payee Name

# ElevenLabs voice for the "machine is ready" voice note.
# Without a key the message goes out as text and QR only.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2

# 0.0.0.0 lets the phone on the shop Wi-Fi reach the laptop.
# HOST=0.0.0.0
# PORT=3000

# Local model settings (defaults shown). VISION_MODEL reads the rating plate photo.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:e4b
# VISION_MODEL=gemma4:e4b
# OLLAMA_KEEP_ALIVE=30m

# whisper.cpp whisper-server for speech to text.
# WHISPER_URL=http://127.0.0.1:8178
# WHISPER_LANGUAGE=hi

# Where private data lives (shop.db, photos, voice notes). Default: data/
# DATA_DIR=data
